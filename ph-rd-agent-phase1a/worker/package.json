{
  "name": "ph-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.mjs --packages=external --loader:.sql=text",
    "start": "node dist/main.mjs",
    "gen-seed": "vite-node scripts/gen-seed.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "pg": "^8.23.1",
    "undici": "^8.12.4",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}